// Samples ThermalSimulation's volumes for a small CONE of rays -- the spot a
// real thermal camera's spot meter measures -- in one dispatch.
//
// Separate from the main simulation shader so it doesn't touch it, and so it
// doesn't share ThermalSimulation's volumeReadBuffer.

#pragma kernel Probe

Texture3D<float> SolidTemp;   // ThermalSimulation.GetSolidTemperatureVolume()  (deg C)
Texture3D<float> AirTemp;     // ThermalSimulation.GetTemperatureVolume()       (deg C)
Texture3D<float> Obstacle;    // ThermalSimulation.GetObstacleVolume()          (1 = solid)
Texture3D<float> FlameHeat;   // ThermalSimulation.GetFireHeatVolume()          (FlameHeatStep output)

// One entry per ray. All float4 so the C# struct layout can't drift.
struct ProbeRay
{
    float4 surfaceVoxel;   // xyz: voxel-space point just inside the hit surface; w: 1 = valid ray
    float4 airVoxel;       // xyz: voxel-space point just in front of the surface
    float4 startVoxel;     // xyz: camera position in voxel space; w: hit distance in voxels
    float4 dirVoxel;       // xyz: normalised direction (voxel space is uniformly scaled world space)
};

StructuredBuffer<ProbeRay> Rays;
int RayCount;

// 5 floats per ray:
// 0 surface temp, 1 max surface temp in 3x3x3, 2 solid voxel count,
// 3 air temp just in front of the surface, 4 max fire heat along the ray.
// Invalid rays (no thermal hit) write -9999 / 0.
RWStructuredBuffer<float> Result;

int3 GridSize;

static const float NoValue = -9999.0;

bool InGrid(int3 v)
{
    return all(v >= 0) && all(v < GridSize);
}

int3 ClampToGrid(int3 v)
{
    return clamp(v, int3(0, 0, 0), GridSize - 1);
}

[numthreads(16, 1, 1)]
void Probe(uint3 id : SV_DispatchThreadID)
{
    int r = (int)id.x;
    if (r >= RayCount) return;

    ProbeRay ray = Rays[r];
    int o = r * 5;

    if (ray.surfaceVoxel.w < 0.5)
    {
        Result[o + 0] = NoValue;
        Result[o + 1] = NoValue;
        Result[o + 2] = 0;
        Result[o + 3] = NoValue;
        Result[o + 4] = 0;
        return;
    }

    int3 centre = ClampToGrid((int3)floor(ray.surfaceVoxel.xyz));

    // --- Surface temperature -------------------------------------------
    // Prefer the voxel the hit point lands in. If the bake put that voxel on
    // the air side (thin objects, grazing hits), fall back to the average of
    // solid neighbours.
    float sum = 0;
    float count = 0;
    float maxT = -1e30;

    for (int z = -1; z <= 1; z++)
    for (int y = -1; y <= 1; y++)
    for (int x = -1; x <= 1; x++)
    {
        int3 v = centre + int3(x, y, z);
        if (!InGrid(v)) continue;
        if (Obstacle[v] < 0.5) continue;

        float t = SolidTemp[v];
        sum += t;
        count += 1;
        maxT = max(maxT, t);
    }

    float surface = NoValue;
    if (Obstacle[centre] > 0.5)      surface = SolidTemp[centre];
    else if (count > 0)              surface = sum / count;

    Result[o + 0] = surface;
    Result[o + 1] = count > 0 ? maxT : NoValue;
    Result[o + 2] = count;

    // --- Air temperature at the surface --------------------------------
    Result[o + 3] = AirTemp[ClampToGrid((int3)floor(ray.airVoxel.xyz))];

    // --- Fire / hot gas along the line of sight ------------------------
    float fireMax = 0;
    int steps = min((int)ceil(ray.startVoxel.w * 2.0), 1024);

    for (int i = 0; i < steps; i++)
    {
        int3 v = (int3)floor(ray.startVoxel.xyz + ray.dirVoxel.xyz * (i * 0.5));
        if (!InGrid(v)) continue;
        if (Obstacle[v] > 0.5) continue;   // only gas cells
        fireMax = max(fireMax, FlameHeat[v]);
    }

    Result[o + 4] = fireMax;
}
