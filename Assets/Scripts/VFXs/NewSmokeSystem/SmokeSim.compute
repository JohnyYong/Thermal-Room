#pragma kernel Emit
#pragma kernel Step
#pragma kernel EmitFire
#pragma kernel StepFire
#pragma kernel Clear
#pragma kernel CopyVolumeToBuffer //Mainly for debugging

// --- Smoke field ---
Texture3D<float>    SmokeIn;
RWTexture3D<float>  SmokeOut;

// --- Fire field ---
Texture3D<float>    FireIn;
RWTexture3D<float>  FireOut;

// Solid geometry.
Texture3D<float>    Obstacle;

// --- Wind ---
float3 WindDirection;
float WindStrength;

// --- Fire/Vent attraction point ---
float3 AttractorCenter;
float AttractorRadius;
float AttractorStrength;

int3   GridSize;
float  DeltaTime;
float  Time_;

// Per-emitter data uploaded as a StructuredBuffer -- supports any number
// of active fire sources sharing the same sim grid.
struct EmitterData
{
    float3 center;      // voxel space
    float  radius;      // voxel space
    float  emitRate;    // smoke density added per second at center
    float  fireRate;    // fire density set per tick (max'd, not added)
};

StructuredBuffer<EmitterData> Emitters;
int EmitterCount;

// Smoke physics.
float  RiseSpeed;
float  SettleSpeed;
float  CeilingSpread;
float  DecayRate;

// Fire physics.
float  FireRiseSpeed;
float  FireDecayRate;
float  FireToSmokeRate;
float  FireCeilingSpread;

// Noise turbulence.
float FireNoiseScale;
float FireNoiseStrength;
float FireNoiseSpeed;
float SmokeNoiseScale;
float SmokeNoiseStrength;
float SmokeNoiseSpeed;

// Smoke turbulence shaping (see Step). All in VOXEL units.
float SmokeWarpClamp;        // hard cap on displacement, voxels
float SmokeShellSharpness;   // how tightly the warp is confined to the boundary
float SmokeAnchorRadius;     // turbulence fades in over this distance from an emitter
float SmokeUseCurlNoise;     // 0 = FBM difference (old), 1 = divergence-free curl noise

// -------------------------------------------------------------------

bool InBounds(int3 p)
{
    return all(p >= int3(0,0,0)) && all(p < GridSize);
}

bool IsSolid(int3 p)
{
    if (!InBounds(p)) return true;
    return Obstacle[p] > 0.5;
}

float ReadSmoke(int3 p)
{
    if (!InBounds(p) || IsSolid(p)) return 0.0;
    return SmokeIn[p];
}

float ReadFire(int3 p)
{
    if (!InBounds(p) || IsSolid(p)) return 0.0;
    return FireIn[p];
}

float Hash3(float3 p)
{
    return frac(sin(dot(p, float3(12.9898, 78.233, 37.719))) * 43758.5453);
}

// Value noise + fractal Brownian motion.
float ValueNoise(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);

    float n000 = Hash3(i + float3(0, 0, 0));
    float n100 = Hash3(i + float3(1, 0, 0));
    float n010 = Hash3(i + float3(0, 1, 0));
    float n110 = Hash3(i + float3(1, 1, 0));
    float n001 = Hash3(i + float3(0, 0, 1));
    float n101 = Hash3(i + float3(1, 0, 1));
    float n011 = Hash3(i + float3(0, 1, 1));
    float n111 = Hash3(i + float3(1, 1, 1));

    float x00 = lerp(n000, n100, f.x);
    float x10 = lerp(n010, n110, f.x);
    float x01 = lerp(n001, n101, f.x);
    float x11 = lerp(n011, n111, f.x);
    float y0  = lerp(x00, x10, f.y);
    float y1  = lerp(x01, x11, f.y);
    return lerp(y0, y1, f.z);
}

float FBM(float3 p)
{
    float total = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    for (int i = 0; i < 3; i++)
    {
        total += ValueNoise(p * freq) * amp;
        freq *= 2.1;
        amp  *= 0.5;
    }
    return total;
}

// Noise-based velocity offset. Biased upward and vertically stretched so
// eddies look like rising flame streaks rather than round spinning blobs.
float3 NoiseVelocity(float3 p, float scale, float speed)
{
    float3 stretchedP = float3(p.x, p.y * 0.4, p.z);

    float3 q = stretchedP * scale + float3(Time_ * speed *  0.3,
                                            Time_ * speed * -2.0,
                                            Time_ * speed *  0.3);

    float ax = FBM(q + float3(  0.0,   0.0,   0.0)) - FBM(q + float3( 47.3,  91.7,  13.1));
    float ay = FBM(q + float3(101.9,  17.3,  61.5)) - FBM(q + float3(-33.7,  55.9, -22.1));
    float az = FBM(q + float3( 71.1,  29.4, 143.2)) - FBM(q + float3( 12.5, -87.3,  99.4));

    return float3(ax, ay, az) * 2.0;
}

// Divergence-free turbulence. The curl of any vector field has zero
// divergence by construction, so this swirls the smoke without locally
// creating or destroying it -- no "breathing" of the plume silhouette.
float3 Potential(float3 x)
{
    return float3(FBM(x),
                  FBM(x + float3( 31.4,  57.7,  12.9)),
                  FBM(x + float3(-73.2,  19.1,  88.6)));
}

float3 CurlNoise(float3 p, float scale, float speed)
{
    float3 stretchedP = float3(p.x, p.y * 0.4, p.z);

    float3 q = stretchedP * scale + float3(Time_ * speed *  0.3,
                                           Time_ * speed * -2.0,
                                           Time_ * speed *  0.3);

    const float e = 0.35;
    float3 dx = float3(e, 0, 0);
    float3 dy = float3(0, e, 0);
    float3 dz = float3(0, 0, e);

    float3 px1 = Potential(q + dx), px0 = Potential(q - dx);
    float3 py1 = Potential(q + dy), py0 = Potential(q - dy);
    float3 pz1 = Potential(q + dz), pz0 = Potential(q - dz);

    float3 curl;
    curl.x = (py1.z - py0.z) - (pz1.y - pz0.y);
    curl.y = (pz1.x - pz0.x) - (px1.z - px0.z);
    curl.z = (px1.y - px0.y) - (py1.x - py0.x);

    return curl / (2.0 * e);
}

// -------------------------------------------------------------------
// SMOKE SAMPLING / SHAPING HELPERS

// Trilinear fetch of the smoke field that still respects obstacles and
// bounds. Fractional displacement is essential: the old integer round()
// snapped the plume a whole voxel at a time, which reads as a jitter.
float SampleSmoke(float3 p)
{
    float3 fl = floor(p);
    float3 f  = p - fl;
    int3   b  = (int3)fl;

    float c000 = ReadSmoke(b + int3(0, 0, 0));
    float c100 = ReadSmoke(b + int3(1, 0, 0));
    float c010 = ReadSmoke(b + int3(0, 1, 0));
    float c110 = ReadSmoke(b + int3(1, 1, 0));
    float c001 = ReadSmoke(b + int3(0, 0, 1));
    float c101 = ReadSmoke(b + int3(1, 0, 1));
    float c011 = ReadSmoke(b + int3(0, 1, 1));
    float c111 = ReadSmoke(b + int3(1, 1, 1));

    float x00 = lerp(c000, c100, f.x);
    float x10 = lerp(c010, c110, f.x);
    float x01 = lerp(c001, c101, f.x);
    float x11 = lerp(c011, c111, f.x);

    return lerp(lerp(x00, x10, f.y), lerp(x01, x11, f.y), f.z);
}

// Same, but a solid cell reads back as `fallback` (the local value) rather
// than 0. Keeps the ceiling-spread laplacian no-flux instead of leaky.
float SampleSmokeWall(float3 p, float fallback)
{
    int3 ip = (int3)round(p);
    return IsSolid(ip) ? fallback : SampleSmoke(p);
}

// ~0 where density is locally uniform (the plume core, and empty air),
// ~1 at a density boundary. Multiplying the warp by this is what stops the
// interior from riding the noise as one rigid block.
float ShellMask(int3 c)
{
    if (SmokeShellSharpness <= 0.0001) return 1.0;   // mask off, warp everywhere

    float gx = ReadSmoke(c + int3(1, 0, 0)) - ReadSmoke(c - int3(1, 0, 0));
    float gy = ReadSmoke(c + int3(0, 1, 0)) - ReadSmoke(c - int3(0, 1, 0));
    float gz = ReadSmoke(c + int3(0, 0, 1)) - ReadSmoke(c - int3(0, 0, 1));

    return saturate(length(float3(gx, gy, gz)) * SmokeShellSharpness);
}

// A real plume is near-laminar for the first couple of source diameters
// and only then breaks into turbulence. Ramping the warp in with distance
// from the nearest emitter anchors the base so the column can't sway at
// its own root.
float EmitterAnchor(float3 p)
{
    if (EmitterCount <= 0 || SmokeAnchorRadius <= 0.0001) return 1.0;

    float nearest = 1e9;
    for (int i = 0; i < EmitterCount; i++)
    {
        EmitterData e = Emitters[i];
        nearest = min(nearest, length(p - e.center) - e.radius);
    }

    return saturate(nearest / SmokeAnchorRadius);
}

// -------------------------------------------------------------------

[numthreads(8,8,8)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;
    SmokeOut[id] = 0.0;
}

// -------------------------------------------------------------------
// SMOKE PIPELINE

[numthreads(8,8,8)]
void Emit(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    float current = SmokeIn[id];

    if (IsSolid(int3(id)))
    {
        SmokeOut[id] = current;
        return;
    }

    float3 p = float3(id) + 0.5;

    // Contributions from every active emitter. Squared-distance early-out
    // skips the sqrt when clearly outside the ball -- cheap perf win when
    // you have many emitters and most voxels are far from all of them.
    for (int i = 0; i < EmitterCount; i++)
    {
        EmitterData e = Emitters[i];
        float3 diff = p - e.center;
        float distSq = dot(diff, diff);
        float rSq = e.radius * e.radius;
        if (distSq >= rSq) continue;

        float d = sqrt(distSq);
        float w = 1.0 - d / max(e.radius, 0.0001);
        current += e.emitRate * DeltaTime * w;
    }

    // Burning voxels also produce smoke, regardless of source.
    float fireHere = FireIn[id];
    if (fireHere > 0.01)
    {
        current += fireHere * FireToSmokeRate * DeltaTime;
    }

    SmokeOut[id] = saturate(current);
}
[numthreads(8,8,8)]
void Step(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    int3 c = int3(id);
    if (IsSolid(c))
    {
        SmokeOut[id] = 0.0;
        return;
    }

    float3 pc = float3(id);        // cell centre in sampling space
    float3 pp = pc + 0.5;          // voxel space; matches emitter/attractor coords

    // ---------------------------------------------------------------
    // Build the displacement.
    // ---------------------------------------------------------------
    float3 turb = (SmokeUseCurlNoise > 0.5)
        ? CurlNoise(pp, SmokeNoiseScale, SmokeNoiseSpeed)
        : NoiseVelocity(pp, SmokeNoiseScale, SmokeNoiseSpeed);

    turb *= SmokeNoiseStrength;

    // Turbulence only deforms the boundary, and only away from the source.
    // Without these two masks the noise translates the whole plume rigidly
    // (its wavelength is wider than the plume), which is the "wobbly centre".
    turb *= ShellMask(c) * EmitterAnchor(pp);

    // Wind and attractor are bulk transport, not turbulence -- never masked.
    float3 windOffset = WindDirection * WindStrength;

    float3 attractorOffset = 0;
    if (AttractorStrength > 0.0)
    {
        float3 toAttractor = AttractorCenter - pp;
        float distAtt = length(toAttractor);
        if (distAtt > 0.001)
        {
            float pull = saturate(1.0 - distAtt / max(AttractorRadius, 0.0001));
            attractorOffset = normalize(toAttractor) * pull * AttractorStrength;
        }
    }

    float3 offset = turb + windOffset + attractorOffset;
    offset.y *= 0.5;
    offset = clamp(offset, -SmokeWarpClamp, SmokeWarpClamp);

    // ---------------------------------------------------------------
    // ONE warped sampling basis. Every tap is taken relative to it.
    //
    // This is the main correction: previously `here` was read at c - off
    // while `below` was read at c - off*0.7 with no Y term, so `below` was
    // not actually below `here`. The rise term fed mass in from a laterally
    // displaced cell every frame and the column leaned with the noise.
    //
    // Backward (semi-Lagrangian) sampling: a voxel wanting to move by
    // +offset must READ from -offset.
    // ---------------------------------------------------------------
    float3 basePos = pc - offset;

    float here  = SampleSmoke(basePos);
    float below = SampleSmoke(basePos + float3(0, -1, 0));
    float above = SampleSmoke(basePos + float3(0,  1, 0));

    // Obstacle queries stay on the TRUE cell, not the warped one.
    bool ceilingAbove = IsSolid(c + int3(0,  1, 0));
    bool floorBelow   = IsSolid(c + int3(0, -1, 0));

    float riseIn  = below * RiseSpeed * DeltaTime;
    float riseOut = ceilingAbove ? 0.0 : here * RiseSpeed * DeltaTime;

    // Soft replacement for the old boolean `activeRisingColumn`. The hard
    // switch flipped per-voxel per-frame as the warp moved, adding shimmer.
    float rising = saturate((below - here * 0.5) * 4.0);

    float settleIn  = above * SettleSpeed * DeltaTime * (1.0 - rising);
    float settleOut = floorBelow
                    ? 0.0
                    : here * SettleSpeed * DeltaTime * (1.0 - rising);

    // Horizontal ceiling spread: the row under a ceiling AND rows below it
    // that have smoke above, so the layer can thicken downward.
    float horizontal = 0.0;
    if (ceilingAbove || above > 0.1)
    {
        float xp = SampleSmokeWall(basePos + float3( 1, 0, 0), here);
        float xn = SampleSmokeWall(basePos + float3(-1, 0, 0), here);
        float zp = SampleSmokeWall(basePos + float3( 0, 0, 1), here);
        float zn = SampleSmokeWall(basePos + float3( 0, 0,-1), here);

        float laplacian = (xp + xn + zp + zn) - 4.0 * here;
        horizontal = laplacian * CeilingSpread * DeltaTime;
    }

    float result = here
                 + riseIn - riseOut
                 + settleIn - settleOut
                 + horizontal;

    result *= (1.0 - DecayRate * DeltaTime);
    SmokeOut[id] = saturate(max(result, 0.0));
}

// -------------------------------------------------------------------
// FIRE PIPELINE

[numthreads(8,8,8)]
void EmitFire(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    float current = FireIn[id];

    if (IsSolid(int3(id)))
    {
        FireOut[id] = current;
        return;
    }

    float3 p = float3(id) + 0.5;

    // Contributions from every emitter -- taking the MAX rather than sum
    // so overlapping fires don't create abnormally bright cores. Per-emitter
    // phase offset makes multiple fires flicker independently.
    for (int i = 0; i < EmitterCount; i++)
    {
        EmitterData e = Emitters[i];
        float3 diff = p - e.center;
        float distSq = dot(diff, diff);
        float rSq = e.radius * e.radius;
        if (distSq >= rSq) continue;

        float d = sqrt(distSq);
        float w = 1.0 - d / max(e.radius, 0.0001);

        float phase = float(i) * 1.7;
        float flickerA = sin(Time_ * 12.0 + Hash3(p) * 6.28 + phase) * 0.5 + 0.5;
        float flickerB = sin(Time_ * 7.3  + Hash3(p + 100) * 6.28 + phase) * 0.5 + 0.5;
        float flicker = 0.6 + 0.4 * flickerA * flickerB;

        current = max(current, w * flicker * e.fireRate);
    }

    FireOut[id] = saturate(current);
}
[numthreads(8,8,8)]
void StepFire(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    if (IsSolid(int3(id)))
    {
        FireOut[id] = 0.0;
        return;
    }

    int3 c = int3(id);

    float3 p = float3(id) + 0.5;
    float3 noise = NoiseVelocity(p, FireNoiseScale, FireNoiseSpeed);

    float3 windOffset = WindDirection * WindStrength;

    float3 attractorOffset = 0;
    if (AttractorStrength > 0.0)
    {
        float3 toAttractor = AttractorCenter - p;
        float distAtt = length(toAttractor);
        if (distAtt > 0.001)
        {
            float pull = saturate(1.0 - distAtt / max(AttractorRadius, 0.0001));
            attractorOffset = normalize(toAttractor) * pull * AttractorStrength * 0.5;
        }
    }

    float3 combinedOffset = noise * FireNoiseStrength + windOffset + attractorOffset;

    // Shell warp for fire outline wobble.
    // NOTE: same backward-sampling correction as Step -- subtract, don't add.
    float offX = clamp(combinedOffset.x, -2.5, 2.5);
    float offY = clamp(combinedOffset.y * 0.5, -1.5, 1.5);
    float offZ = clamp(combinedOffset.z, -2.5, 2.5);

    int3 herePos = c - int3((int)round(offX), (int)round(offY), (int)round(offZ));
    float here = ReadFire(herePos);

    int3 belowPos = c + int3(-(int)round(offX * 0.7), -1, -(int)round(offZ * 0.7));
    float noiseBelow = ReadFire(belowPos);
    float straightBelow = ReadFire(c + int3(0, -1, 0));
    float below = noiseBelow * 0.6 + straightBelow * 0.4;

    bool ceilingAbove = IsSolid(c + int3(0, 1, 0));

    float riseIn  = below * FireRiseSpeed * DeltaTime;
    float riseOut = ceilingAbove ? 0.0 : here * FireRiseSpeed * DeltaTime;

    // Ceiling rollover.
    float horizontal = 0.0;
    if (ceilingAbove)
    {
        int3 xpP = c + int3( 1, 0, 0);
        int3 xnP = c + int3(-1, 0, 0);
        int3 zpP = c + int3( 0, 0, 1);
        int3 znP = c + int3( 0, 0,-1);

        float xp = IsSolid(xpP) ? here : FireIn[xpP];
        float xn = IsSolid(xnP) ? here : FireIn[xnP];
        float zp = IsSolid(zpP) ? here : FireIn[zpP];
        float zn = IsSolid(znP) ? here : FireIn[znP];

        float laplacian = (xp + xn + zp + zn) - 4.0 * here;
        horizontal = laplacian * FireCeilingSpread * DeltaTime;
    }

    float result = here + riseIn - riseOut + horizontal;

    result *= (1.0 - FireDecayRate * DeltaTime);

    FireOut[id] = saturate(max(result, 0.0));
}

// AsyncGPUReadback.Request on a Tex3D returns only z=0 on many backends.
// To read a full volume reliably, copy it to a linear StructuredBuffer
// first (buffers don't have this limitation), then read the buffer.
Texture3D<float>          CopySource;
RWStructuredBuffer<float> CopyDest;
int3                      CopyDims;

[numthreads(8,8,4)]
void CopyVolumeToBuffer(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)CopyDims.x || id.y >= (uint)CopyDims.y || id.z >= (uint)CopyDims.z)
        return;

    int index = id.x + CopyDims.x * (id.y + CopyDims.y * id.z);
    CopyDest[index] = CopySource[id];
}