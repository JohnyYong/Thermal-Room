#pragma kernel Emit
#pragma kernel Step
#pragma kernel EmitFire
#pragma kernel StepFire
#pragma kernel Clear
#pragma kernel CopyVolumeToBuffer //Mainly for debugging

// --- Smoke field ---
Texture3D<float>    SmokeIn;
RWTexture3D<float>  SmokeOut;

// --- Fire field ---
Texture3D<float>    FireIn;
RWTexture3D<float>  FireOut;

// Solid geometry.
Texture3D<float>    Obstacle;

// --- Wind ---
float3 WindDirection;
float WindStrength;

// --- Fire/Vent attraction point ---
float3 AttractorCenter;
float AttractorRadius;
float AttractorStrength;

int3   GridSize;
float  DeltaTime;
float  Time_;

// This grid's own world-space placement -- needed to convert a voxel id
// into a world position for sampling ThermalSimulation's velocity field
// (which lives in a different grid, resolution, and origin).
float3 Origin;
float  CellSize;

// Per-emitter data uploaded as a StructuredBuffer -- supports any number
// of active fire sources sharing the same sim grid.
struct EmitterData
{
    float3 center;      // voxel space
    float  radius;      // voxel space
    float  emitRate;    // smoke density added per second at center
    float  fireRate;    // fire density set per tick (max'd, not added)
};

StructuredBuffer<EmitterData> Emitters;
int EmitterCount;

// Smoke physics.
float  RiseSpeed;
float  SettleSpeed;
float  CeilingSpread;
float  DecayRate;

// Fire physics.
float  FireRiseSpeed;
float  FireDecayRate;
float  FireToSmokeRate;
float  FireCeilingSpread;

// Noise turbulence.
float FireNoiseScale;
float FireNoiseStrength;
float FireNoiseSpeed;
float SmokeNoiseScale;
float SmokeNoiseStrength;
float SmokeNoiseSpeed;
float DriftSpeed;

// --- External (real) velocity field, e.g. from ThermalSimulation ---
// A completely different grid than this one -- different resolution,
// cell size, and world-space origin -- so sampling it requires converting
// through world space rather than direct voxel indexing.
Texture3D<float4> ExternalVelocity;
float3 ExternalOrigin;
float  ExternalCellSize;
int3   ExternalGridSize;
float  ExternalVelocityInfluence;

// -------------------------------------------------------------------

bool InBounds(int3 p)
{
    return all(p >= int3(0,0,0)) && all(p < GridSize);
}

bool IsSolid(int3 p)
{
    if (!InBounds(p)) return true;
    return Obstacle[p] > 0.5;
}

float ReadSmoke(int3 p)
{
    if (!InBounds(p) || IsSolid(p)) return 0.0;
    return SmokeIn[p];
}

float ReadFire(int3 p)
{
    if (!InBounds(p) || IsSolid(p)) return 0.0;
    return FireIn[p];
}

float Hash3(float3 p)
{
    return frac(sin(dot(p, float3(12.9898, 78.233, 37.719))) * 43758.5453);
}

// Value noise + fractal Brownian motion.
float ValueNoise(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);

    float n000 = Hash3(i + float3(0, 0, 0));
    float n100 = Hash3(i + float3(1, 0, 0));
    float n010 = Hash3(i + float3(0, 1, 0));
    float n110 = Hash3(i + float3(1, 1, 0));
    float n001 = Hash3(i + float3(0, 0, 1));
    float n101 = Hash3(i + float3(1, 0, 1));
    float n011 = Hash3(i + float3(0, 1, 1));
    float n111 = Hash3(i + float3(1, 1, 1));

    float x00 = lerp(n000, n100, f.x);
    float x10 = lerp(n010, n110, f.x);
    float x01 = lerp(n001, n101, f.x);
    float x11 = lerp(n011, n111, f.x);
    float y0  = lerp(x00, x10, f.y);
    float y1  = lerp(x01, x11, f.y);
    return lerp(y0, y1, f.z);
}

float FBM(float3 p)
{
    float total = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    for (int i = 0; i < 3; i++)
    {
        total += ValueNoise(p * freq) * amp;
        freq *= 2.1;
        amp  *= 0.5;
    }
    return total;
}

// Noise-based velocity offset. Biased upward and vertically stretched so
// eddies look like rising flame streaks rather than round spinning blobs.
float3 NoiseVelocity(float3 p, float scale, float speed)
{
    float3 stretchedP = float3(p.x, p.y * 0.4, p.z);

    float3 q = stretchedP * scale + float3(Time_ * speed *  0.3,
                                            Time_ * speed * -2.0,
                                            Time_ * speed *  0.3);

    float ax = FBM(q + float3(  0.0,   0.0,   0.0)) - FBM(q + float3( 47.3,  91.7,  13.1));
    float ay = FBM(q + float3(101.9,  17.3,  61.5)) - FBM(q + float3(-33.7,  55.9, -22.1));
    float az = FBM(q + float3( 71.1,  29.4, 143.2)) - FBM(q + float3( 12.5, -87.3,  99.4));

    return float3(ax, ay, az) * 2.0;
}

// Manual trilinear sample of the external velocity field, in ITS OWN
// voxel space (continuous coordinates, not integer). Same technique as
// ThermalSimulation.compute's SampleVelocity -- that texture has no
// SamplerState bound here, so this does the interpolation by hand across
// the 8 neighboring texels.
float4 SampleExternalVelocityRaw(float3 voxelPos)
{
    float3 maxCoord = float3(ExternalGridSize) - 2.0;
    voxelPos = clamp(voxelPos, float3(0, 0, 0), max(maxCoord, float3(0,0,0)));

    int3 p0 = int3(floor(voxelPos));
    int3 p1 = p0 + 1;
    float3 f = frac(voxelPos);

    float4 c000 = ExternalVelocity[p0];
    float4 c100 = ExternalVelocity[int3(p1.x, p0.y, p0.z)];
    float4 c010 = ExternalVelocity[int3(p0.x, p1.y, p0.z)];
    float4 c110 = ExternalVelocity[int3(p1.x, p1.y, p0.z)];
    float4 c001 = ExternalVelocity[int3(p0.x, p0.y, p1.z)];
    float4 c101 = ExternalVelocity[int3(p1.x, p0.y, p1.z)];
    float4 c011 = ExternalVelocity[int3(p0.x, p1.y, p1.z)];
    float4 c111 = ExternalVelocity[p1];

    float4 c00 = lerp(c000, c100, f.x);
    float4 c10 = lerp(c010, c110, f.x);
    float4 c01 = lerp(c001, c101, f.x);
    float4 c11 = lerp(c011, c111, f.x);

    float4 c0 = lerp(c00, c10, f.y);
    float4 c1 = lerp(c01, c11, f.y);

    return lerp(c0, c1, f.z);
}

// Returns a per-tick VOXEL-SPACE offset (in THIS grid's voxels, already
// multiplied by DeltaTime and ExternalVelocityInfluence) for a given
// world position -- ready to add directly into combinedOffset alongside
// noise/wind/attractor, which are also per-tick voxel-space quantities.
//
// Unit chain: ExternalVelocity is stored in the source grid's voxels/sec
// -> multiply by ExternalCellSize to get world units/sec -> divide by
// THIS grid's CellSize to get THIS grid's voxels/sec -> multiply by
// DeltaTime to get voxels this tick -> scale by influence.
float3 SampleExternalVelocityOffset(float3 worldPos)
{
    if (ExternalVelocityInfluence <= 0.0001) return float3(0, 0, 0);

    float3 extVoxelPos = (worldPos - ExternalOrigin) / max(ExternalCellSize, 0.0001);
    float4 velRaw = SampleExternalVelocityRaw(extVoxelPos);

    float3 velWorldPerSec = velRaw.xyz * ExternalCellSize;
    float3 velOwnVoxelsPerSec = velWorldPerSec / max(CellSize, 0.0001);

    return velOwnVoxelsPerSec * DeltaTime * ExternalVelocityInfluence;
}

// -------------------------------------------------------------------

[numthreads(8,8,8)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;
    SmokeOut[id] = 0.0;
}

// -------------------------------------------------------------------
// SMOKE PIPELINE

[numthreads(8,8,8)]
void Emit(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    float current = SmokeIn[id];

    if (IsSolid(int3(id)))
    {
        SmokeOut[id] = current;
        return;
    }

    float3 p = float3(id) + 0.5;

    // Contributions from every active emitter. Squared-distance early-out
    // skips the sqrt when clearly outside the ball -- cheap perf win when
    // you have many emitters and most voxels are far from all of them.
    for (int i = 0; i < EmitterCount; i++)
    {
        EmitterData e = Emitters[i];
        float3 diff = p - e.center;
        float distSq = dot(diff, diff);
        float rSq = e.radius * e.radius;
        if (distSq >= rSq) continue;

        float d = sqrt(distSq);
        float w = 1.0 - d / max(e.radius, 0.0001);
        current += e.emitRate * DeltaTime * w;
    }

    // Burning voxels also produce smoke, regardless of source.
    float fireHere = FireIn[id];
    if (fireHere > 0.01)
    {
        current += fireHere * FireToSmokeRate * DeltaTime;
    }

    SmokeOut[id] = saturate(current);
}
[numthreads(8,8,8)]
void Step(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    if (IsSolid(int3(id)))
    {
        SmokeOut[id] = 0.0;
        return;
    }

    int3 c = int3(id);

    // Sample noise for this voxel's turbulence direction.
    float3 pp = float3(id) + 0.5;
    float3 noise = NoiseVelocity(pp, SmokeNoiseScale, SmokeNoiseSpeed);

    float3 windOffset = WindDirection * WindStrength;

    float3 attractorOffset = 0;
    if (AttractorStrength > 0.0)
    {
        float3 toAttractor = AttractorCenter - pp;
        float distAtt = length(toAttractor);
        if (distAtt > 0.001)
        {
            float pull = saturate(1.0 - distAtt / max(AttractorRadius, 0.0001));
            attractorOffset = normalize(toAttractor) * pull * AttractorStrength;
        }
    }

    // Real room airflow, sampled from ThermalSimulation's pressure-
    // projected velocity field. This is what actually gives obstacle
    // deflection/banking/venting -- it's already baked into the sampled
    // velocity by that sim's own pressure solve, so nothing extra needs
    // to happen here beyond adding it to the offset like any other term.
    float3 worldPos = Origin + pp * CellSize;
    float3 externalOffset = SampleExternalVelocityOffset(worldPos);

    float3 combinedOffset = (noise * SmokeNoiseStrength + windOffset + attractorOffset) * DriftSpeed
                           + externalOffset;
    // Shell warp: read `here` from a noise-displaced position so smoke's
    // outline wobbles, matching Kelvin-Helmholtz billowing behaviour.
    // NOTE: subtract the offset -- we're doing backward (semi-Lagrangian)
    // sampling, so a voxel wanting to move by +offset must READ from -offset.
    float offX = clamp(combinedOffset.x, -2.5, 2.5);
    float offY = clamp(combinedOffset.y * 0.5, -1.5, 1.5);
    float offZ = clamp(combinedOffset.z, -2.5, 2.5);

    int3 herePos = c - int3((int)round(offX), (int)round(offY), (int)round(offZ));
    float here = ReadSmoke(herePos);

    // Rise sample: pull from below with lighter noise offset, blended with
    // straight-below so we always have some vertical component regardless
    // of what the noise says this frame. Horizontal noise offset is also
    // inverted here for the same backward-sampling reason; the vertical
    // "-1" (straight down) is NOT flipped -- that's the rise mechanic.
    int3 belowPos = c + int3(-(int)round(offX * 0.7), -1, -(int)round(offZ * 0.7));
    float noiseBelow = ReadSmoke(belowPos);
    float straightBelow = ReadSmoke(c + int3(0, -1, 0));
    float below = noiseBelow * 0.5 + straightBelow * 0.5;

    float above = ReadSmoke(c + int3(0, 1, 0));

    bool ceilingAbove = IsSolid(c + int3(0,  1, 0));
    bool floorBelow   = IsSolid(c + int3(0, -1, 0));

    float riseIn  = below * RiseSpeed * DeltaTime;
    float riseOut = ceilingAbove ? 0.0 : here * RiseSpeed * DeltaTime;

    // Settle only where we're NOT in an active rising column, so the plume
    // rises cleanly while outer edges of the ceiling layer drift down.
    bool activeRisingColumn = (below > here * 0.5);
    float settleIn = 0.0;
    float settleOut = 0.0;
    if (!activeRisingColumn)
    {
        settleIn  = above * SettleSpeed * DeltaTime;
        settleOut = floorBelow ? 0.0 : here * SettleSpeed * DeltaTime;
    }

    // Horizontal ceiling spread: applies to the row under a ceiling AND
    // rows below with smoke above -- lets the layer thicken downward.
    float horizontal = 0.0;
    bool inLayer = ceilingAbove || (above > 0.1);
    if (inLayer)
    {
        int3 xpP = c + int3( 1, 0, 0);
        int3 xnP = c + int3(-1, 0, 0);
        int3 zpP = c + int3( 0, 0, 1);
        int3 znP = c + int3( 0, 0,-1);

        float xp = IsSolid(xpP) ? here : SmokeIn[xpP];
        float xn = IsSolid(xnP) ? here : SmokeIn[xnP];
        float zp = IsSolid(zpP) ? here : SmokeIn[zpP];
        float zn = IsSolid(znP) ? here : SmokeIn[znP];

        float laplacian = (xp + xn + zp + zn) - 4.0 * here;
        horizontal = laplacian * CeilingSpread * DeltaTime;
    }

    float result = here
                 + riseIn - riseOut
                 + settleIn - settleOut
                 + horizontal;

    result *= (1.0 - DecayRate * DeltaTime);
    SmokeOut[id] = saturate(max(result, 0.0));
}
// -------------------------------------------------------------------
// FIRE PIPELINE

[numthreads(8,8,8)]
void EmitFire(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    float current = FireIn[id];

    if (IsSolid(int3(id)))
    {
        FireOut[id] = current;
        return;
    }

    float3 p = float3(id) + 0.5;

    // Contributions from every emitter -- taking the MAX rather than sum
    // so overlapping fires don't create abnormally bright cores. Per-emitter
    // phase offset makes multiple fires flicker independently.
    for (int i = 0; i < EmitterCount; i++)
    {
        EmitterData e = Emitters[i];
        float3 diff = p - e.center;
        float distSq = dot(diff, diff);
        float rSq = e.radius * e.radius;
        if (distSq >= rSq) continue;

        float d = sqrt(distSq);
        float w = 1.0 - d / max(e.radius, 0.0001);

        float phase = float(i) * 1.7;
        float flickerA = sin(Time_ * 12.0 + Hash3(p) * 6.28 + phase) * 0.5 + 0.5;
        float flickerB = sin(Time_ * 7.3  + Hash3(p + 100) * 6.28 + phase) * 0.5 + 0.5;
        float flicker = 0.6 + 0.4 * flickerA * flickerB;

        current = max(current, w * flicker * e.fireRate);
    }

    FireOut[id] = saturate(current);
}
[numthreads(8,8,8)]
void StepFire(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    if (IsSolid(int3(id)))
    {
        FireOut[id] = 0.0;
        return;
    }

    int3 c = int3(id);

    float3 p = float3(id) + 0.5;
    float3 noise = NoiseVelocity(p, FireNoiseScale, FireNoiseSpeed);

    float3 windOffset = WindDirection * WindStrength;

    float3 attractorOffset = 0;
    if (AttractorStrength > 0.0)
    {
        float3 toAttractor = AttractorCenter - p;
        float distAtt = length(toAttractor);
        if (distAtt > 0.001)
        {
            float pull = saturate(1.0 - distAtt / max(AttractorRadius, 0.0001));
            attractorOffset = normalize(toAttractor) * pull * AttractorStrength * 0.5;
        }
    }

    // Real room airflow -- same sampling as Step. Fire gets the full
    // sampled offset here (not halved like attractorOffset above); if you
    // want fire to feel a bit more anchored than smoke, scale this down
    // in the same style as attractorOffset's own * 0.5.
    float3 worldPos = Origin + p * CellSize;
    float3 externalOffset = SampleExternalVelocityOffset(worldPos);

    float3 combinedOffset = (noise * FireNoiseStrength + windOffset + attractorOffset) * DriftSpeed
                           + externalOffset;

    // Shell warp for fire outline wobble.
    // NOTE: same backward-sampling correction as Step -- subtract, don't add.
    float offX = clamp(combinedOffset.x, -2.5, 2.5);
    float offY = clamp(combinedOffset.y * 0.5, -1.5, 1.5);
    float offZ = clamp(combinedOffset.z, -2.5, 2.5);

    int3 herePos = c - int3((int)round(offX), (int)round(offY), (int)round(offZ));
    float here = ReadFire(herePos);

    int3 belowPos = c + int3(-(int)round(offX * 0.7), -1, -(int)round(offZ * 0.7));
    float noiseBelow = ReadFire(belowPos);
    float straightBelow = ReadFire(c + int3(0, -1, 0));
    float below = noiseBelow * 0.6 + straightBelow * 0.4;

    bool ceilingAbove = IsSolid(c + int3(0, 1, 0));

    float riseIn  = below * FireRiseSpeed * DeltaTime;
    float riseOut = ceilingAbove ? 0.0 : here * FireRiseSpeed * DeltaTime;

    // Ceiling rollover.
    float horizontal = 0.0;
    if (ceilingAbove)
    {
        int3 xpP = c + int3( 1, 0, 0);
        int3 xnP = c + int3(-1, 0, 0);
        int3 zpP = c + int3( 0, 0, 1);
        int3 znP = c + int3( 0, 0,-1);

        float xp = IsSolid(xpP) ? here : FireIn[xpP];
        float xn = IsSolid(xnP) ? here : FireIn[xnP];
        float zp = IsSolid(zpP) ? here : FireIn[zpP];
        float zn = IsSolid(znP) ? here : FireIn[znP];

        float laplacian = (xp + xn + zp + zn) - 4.0 * here;
        horizontal = laplacian * FireCeilingSpread * DeltaTime;
    }

    float result = here + riseIn - riseOut + horizontal;

    result *= (1.0 - FireDecayRate * DeltaTime);

    FireOut[id] = saturate(max(result, 0.0));
}

// AsyncGPUReadback.Request on a Tex3D returns only z=0 on many backends.
// To read a full volume reliably, copy it to a linear StructuredBuffer
// first (buffers don't have this limitation), then read the buffer.
Texture3D<float>          CopySource;
RWStructuredBuffer<float> CopyDest;
int3                      CopyDims;

[numthreads(8,8,4)]
void CopyVolumeToBuffer(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)CopyDims.x || id.y >= (uint)CopyDims.y || id.z >= (uint)CopyDims.z)
        return;

    int index = id.x + CopyDims.x * (id.y + CopyDims.y * id.z);
    CopyDest[index] = CopySource[id];
}
