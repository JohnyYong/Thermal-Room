#pragma kernel Emit
#pragma kernel Step
#pragma kernel EmitFire
#pragma kernel StepFire
#pragma kernel FireEmission
#pragma kernel Clear
#pragma kernel CopyVolumeToBuffer //Mainly for debugging

// --- Smoke field ---
Texture3D<float>    SmokeIn;
RWTexture3D<float>  SmokeOut;

// --- Fire field ---
Texture3D<float>    FireIn;
RWTexture3D<float>  FireOut;

// Solid geometry.
Texture3D<float>    Obstacle;

// --- Wind ---
float3 WindDirection;
float WindStrength;

// --- Fire/Vent attraction point ---
float3 AttractorCenter;
float AttractorRadius;       // falloff distance BEYOND the box surface, voxels
float3 AttractorHalfExtents; // box half-size in voxels; 0 = point attractor
float3 AttractorFlowDir;     // unit direction smoke takes once inside the box
float AttractorStrength;

int3   GridSize;
float  DeltaTime;
float  Time_;

// 0 = the six faces of the sim grid behave as solid walls (sealed box).
// 1 = they are open to the outside world and smoke/fire drains out of them.
float  OpenBoundary;

// ===================================================================
// COARSE SOLVER COUPLING
//
// This grid no longer invents its own transport. ThermalSimulation runs
// a real Navier-Stokes solve on a coarser grid (buoyancy -> advection ->
// vorticity -> pressure projection) and hands the resulting velocity
// field over here. Smoke and fire are advected by that field, so the
// motion obeys incompressible flow and matches, cell for cell, what the
// thermal imager sees.
//
// Velocity is in METRES PER SECOND in both sims. That shared physical
// unit is what lets a 0.1 m grid and a 0.3 m grid agree.
//
// Curl noise is still added on top, but its role has changed: it is now
// genuine SUB-GRID turbulence, supplying the eddies smaller than the
// coarse solver's cell size that the solver physically cannot represent.
// ===================================================================
Texture3D<float4> CoarseVelocity;
int3   CoarseGridSize;
float  CellSizeMeters;      // metres per voxel of THIS (fine) grid
float  FineOverCoarse;      // fine cell size / coarse cell size (e.g. 1/3)
float  VelocityInfluence;   // 0..1, how much of the solver field to use

// Sub-grid buoyancy. A 0.3 m solver cannot resolve the acceleration
// inside a flame only a couple of coarse cells wide, so the remainder is
// added here where the flame is actually resolved. See TransportOffset.
float  SubGridBuoyancy;     // 0..1 fraction of the ideal plume velocity sqrt(2 g' h)
float  FlameGasTempK;       // absolute flame gas temperature, Kelvin
float  AmbientTempK;        // absolute ambient temperature, Kelvin

// Air drawn into the plume at about this fraction of its rise speed
// (Morton-Taylor-Turner entrainment coefficient, ~0.1). Necks the flame
// toward its axis so it tapers instead of rising as a straight column.
float  PlumeEntrainment;

// Reaction-sheet emission. See the FireEmission kernel.
RWTexture3D<float> FireEmissionOut;
float  ReactionSheetScale;
float  ReactionSheetWeight;

// Per-emitter data uploaded as a StructuredBuffer -- supports any number
// of active fire sources sharing the same sim grid.
//
// An emitter is a fuel BED, not a ball: `center` is the centre of the
// burning surface and `radius` is the bed's horizontal radius. Flame and
// smoke are emitted in a thin lens there and rise from it.
struct EmitterData
{
    float3 center;      // voxel space
    float  radius;      // voxel space
    float  emitRate;    // smoke density added per second at center
    float  fireRate;    // fire density set per tick (max'd, not added)
};

StructuredBuffer<EmitterData> Emitters;
int EmitterCount;

// Fuel bed shape. See BedWeight / EmitFire.
float  FireBedThickness;    // bed half-height as a fraction of emitter radius
float  FireBedBreakup;      // 0 = uniform disc, 1 = fully broken into hot spots
float  FireBedNoiseScale;   // 1 / hot-spot size, in fine voxels
float  FireBedNoiseSpeed;   // how fast hot spots come and go, 1/s

// -------------------------------------------------------------------
// Burning surfaces from ThermalSimulation.
//
// ThermalSimulation owns combustion: which solid voxels are alight,
// including runtime-ignited objects and fire that has spread. Reading
// its burning field here means every burning surface emits visible
// flame on this grid automatically -- no per-fire emitter needed, and
// spread fire shows up the moment the coarse sim ignites a voxel.
// -------------------------------------------------------------------
Texture3D<float> CoarseBurning;
Texture3D<float> CoarseObstacle;
float  UseCoarseBurning;    // 0 = off (no thermal sim, or disabled)
float  SurfaceFireRate;     // fire density at a fully burning surface
float  SurfaceSmokeRate;    // smoke density per second at a burning surface
float  SurfaceFlameDepth;   // fine voxels: how far out from a surface flame is emitted

// Smoke physics.
// UNUSED: vertical smoke motion comes from the coarse solver velocity and
// the SubGridBuoyancy term in TransportOffset, not from these. Kept only
// so the existing SetFloat calls in SmokeSim.cs don't error. Adjust
// VelocityInfluence / SubGridBuoyancy instead.
float  RiseSpeed;
float  SettleSpeed;
float  CeilingSpread;
float  DecayRate;

// Fire physics.
float  FireRiseSpeed;       // UNUSED: see RiseSpeed above
float  FireDecayRate;
float  FireToSmokeRate;
float  FireCeilingSpread;   // unused now: ceiling rollover comes from the solver
float  FireCutoff;         // per-second subtraction that keeps flame tips crisp

float  SmokeDiffusion;     // physical soot diffusion; keep small

// How strongly bright flame suppresses smoke production in its own cell.
// 1 = a fully luminous cell makes no visible smoke at all.
float  SootLuminousCutoff;

// Flame intermittency. See FlameDilution / StepFire.
// Despite the name this is now a HEIGHT above the fuel bed, in voxels --
// which is what flamePersistentHeight in SmokeSim.cs always described.
float  FlamePersistentRadius;  // voxels: height of the continuously lit zone
float  FlameIntermittency;     // 1/s extinction rate in the diluted region

// Noise turbulence.
float FireNoiseScale;
float FireNoiseStrength;
float FireNoiseSpeed;
float SmokeNoiseScale;
float SmokeNoiseStrength;
float SmokeNoiseSpeed;

// Smoke turbulence shaping (see Step). All in VOXEL units.
float SmokeWarpClamp;        // hard cap on displacement, voxels
float SmokeShellSharpness;   // how tightly the warp is confined to the boundary
float SmokeAnchorRadius;     // turbulence fades in over this height above a bed
float SmokeUseCurlNoise;     // 0 = FBM difference (old), 1 = divergence-free curl noise

// -------------------------------------------------------------------

bool InBounds(int3 p)
{
    return all(p >= int3(0,0,0)) && all(p < GridSize);
}

bool IsSolid(int3 p)
{
    // Outside the grid is either a wall or open air, depending on
    // OpenBoundary. Treating it as a wall (the old behaviour) makes the sim
    // volume a sealed box that can only ever fill up.
    if (!InBounds(p)) return OpenBoundary > 0.5 ? false : true;
    return Obstacle[p] > 0.5;
}

float ReadSmoke(int3 p)
{
    if (!InBounds(p) || IsSolid(p)) return 0.0;
    return SmokeIn[p];
}

float ReadFire(int3 p)
{
    if (!InBounds(p) || IsSolid(p)) return 0.0;
    return FireIn[p];
}

float Hash3(float3 p)
{
    return frac(sin(dot(p, float3(12.9898, 78.233, 37.719))) * 43758.5453);
}

// Value noise + fractal Brownian motion.
float ValueNoise(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);

    float n000 = Hash3(i + float3(0, 0, 0));
    float n100 = Hash3(i + float3(1, 0, 0));
    float n010 = Hash3(i + float3(0, 1, 0));
    float n110 = Hash3(i + float3(1, 1, 0));
    float n001 = Hash3(i + float3(0, 0, 1));
    float n101 = Hash3(i + float3(1, 0, 1));
    float n011 = Hash3(i + float3(0, 1, 1));
    float n111 = Hash3(i + float3(1, 1, 1));

    float x00 = lerp(n000, n100, f.x);
    float x10 = lerp(n010, n110, f.x);
    float x01 = lerp(n001, n101, f.x);
    float x11 = lerp(n011, n111, f.x);
    float y0  = lerp(x00, x10, f.y);
    float y1  = lerp(x01, x11, f.y);
    return lerp(y0, y1, f.z);
}

float FBM(float3 p)
{
    float total = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    for (int i = 0; i < 3; i++)
    {
        total += ValueNoise(p * freq) * amp;
        freq *= 2.1;
        amp  *= 0.5;
    }
    return total;
}

// Noise-based velocity offset. Biased upward and vertically stretched so
// eddies look like rising flame streaks rather than round spinning blobs.
float3 NoiseVelocity(float3 p, float scale, float speed)
{
    float3 stretchedP = float3(p.x, p.y * 0.4, p.z);

    float3 q = stretchedP * scale + float3(Time_ * speed *  0.3,
                                            Time_ * speed * -2.0,
                                            Time_ * speed *  0.3);

    float ax = FBM(q + float3(  0.0,   0.0,   0.0)) - FBM(q + float3( 47.3,  91.7,  13.1));
    float ay = FBM(q + float3(101.9,  17.3,  61.5)) - FBM(q + float3(-33.7,  55.9, -22.1));
    float az = FBM(q + float3( 71.1,  29.4, 143.2)) - FBM(q + float3( 12.5, -87.3,  99.4));

    return float3(ax, ay, az) * 2.0;
}

// Divergence-free turbulence. The curl of any vector field has zero
// divergence by construction, so this swirls the smoke without locally
// creating or destroying it -- no "breathing" of the plume silhouette.
float3 Potential(float3 x)
{
    return float3(FBM(x),
                  FBM(x + float3( 31.4,  57.7,  12.9)),
                  FBM(x + float3(-73.2,  19.1,  88.6)));
}

float3 CurlNoise(float3 p, float scale, float speed)
{
    float3 stretchedP = float3(p.x, p.y * 0.4, p.z);

    float3 q = stretchedP * scale + float3(Time_ * speed *  0.3,
                                           Time_ * speed * -2.0,
                                           Time_ * speed *  0.3);

    const float e = 0.35;
    float3 dx = float3(e, 0, 0);
    float3 dy = float3(0, e, 0);
    float3 dz = float3(0, 0, e);

    float3 px1 = Potential(q + dx), px0 = Potential(q - dx);
    float3 py1 = Potential(q + dy), py0 = Potential(q - dy);
    float3 pz1 = Potential(q + dz), pz0 = Potential(q - dz);

    float3 curl;
    curl.x = (py1.z - py0.z) - (pz1.y - pz0.y);
    curl.y = (pz1.x - pz0.x) - (px1.z - px0.z);
    curl.z = (px1.y - px0.y) - (py1.x - py0.x);

    return curl / (2.0 * e);
}

// -------------------------------------------------------------------
// SMOKE SAMPLING / SHAPING HELPERS

// Trilinear fetch of the smoke field that still respects obstacles and
// bounds. Fractional displacement is essential: the old integer round()
// snapped the plume a whole voxel at a time, which reads as a jitter.
float SampleSmoke(float3 p)
{
    float3 fl = floor(p);
    float3 f  = p - fl;
    int3   b  = (int3)fl;

    float c000 = ReadSmoke(b + int3(0, 0, 0));
    float c100 = ReadSmoke(b + int3(1, 0, 0));
    float c010 = ReadSmoke(b + int3(0, 1, 0));
    float c110 = ReadSmoke(b + int3(1, 1, 0));
    float c001 = ReadSmoke(b + int3(0, 0, 1));
    float c101 = ReadSmoke(b + int3(1, 0, 1));
    float c011 = ReadSmoke(b + int3(0, 1, 1));
    float c111 = ReadSmoke(b + int3(1, 1, 1));

    float x00 = lerp(c000, c100, f.x);
    float x10 = lerp(c010, c110, f.x);
    float x01 = lerp(c001, c101, f.x);
    float x11 = lerp(c011, c111, f.x);

    return lerp(lerp(x00, x10, f.y), lerp(x01, x11, f.y), f.z);
}

// Same, but a solid cell reads back as `fallback` (the local value) rather
// than 0. Keeps the ceiling-spread laplacian no-flux instead of leaky.
float SampleSmokeWall(float3 p, float fallback)
{
    int3 ip = (int3)round(p);
    return IsSolid(ip) ? fallback : SampleSmoke(p);
}

// Trilinear fetch of the fine FIRE field, matching SampleSmoke.
float SampleFire(float3 p)
{
    float3 fl = floor(p);
    float3 f  = p - fl;
    int3   b  = (int3)fl;

    float c000 = ReadFire(b + int3(0, 0, 0));
    float c100 = ReadFire(b + int3(1, 0, 0));
    float c010 = ReadFire(b + int3(0, 1, 0));
    float c110 = ReadFire(b + int3(1, 1, 0));
    float c001 = ReadFire(b + int3(0, 0, 1));
    float c101 = ReadFire(b + int3(1, 0, 1));
    float c011 = ReadFire(b + int3(0, 1, 1));
    float c111 = ReadFire(b + int3(1, 1, 1));

    float x00 = lerp(c000, c100, f.x);
    float x10 = lerp(c010, c110, f.x);
    float x01 = lerp(c001, c101, f.x);
    float x11 = lerp(c011, c111, f.x);

    return lerp(lerp(x00, x10, f.y), lerp(x01, x11, f.y), f.z);
}

// Min/max over the 8 cells a trilinear fetch at p would touch. The
// MacCormack correction below is unstable without clamping to this range.
void SampleBoundsSmoke(float3 p, out float lo, out float hi)
{
    int3 b = (int3)floor(p);

    lo =  1e9;
    hi = -1e9;

    for (int i = 0; i < 8; i++)
    {
        int3 o = int3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        float v = ReadSmoke(b + o);
        lo = min(lo, v);
        hi = max(hi, v);
    }
}

void SampleBoundsFire(float3 p, out float lo, out float hi)
{
    int3 b = (int3)floor(p);

    lo =  1e9;
    hi = -1e9;

    for (int i = 0; i < 8; i++)
    {
        int3 o = int3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        float v = ReadFire(b + o);
        lo = min(lo, v);
        hi = max(hi, v);
    }
}

// -------------------------------------------------------------------
// Solver velocity, upsampled.
//
// Both grids share a world origin, so fine voxel centre (id + 0.5) maps
// to coarse coordinate (id + 0.5) * FineOverCoarse - 0.5.
// Returns metres per second.
// -------------------------------------------------------------------
float3 SampleCoarseVelocity(float3 fineCentre)
{
    float3 cp = fineCentre * FineOverCoarse - 0.5;

    cp = clamp(cp, float3(0, 0, 0), (float3)(CoarseGridSize - 1) - 0.001);

    float3 fl = floor(cp);
    float3 f  = cp - fl;
    int3   b  = (int3)fl;

    int3 hi = min(b + 1, CoarseGridSize - 1);

    float3 c000 = CoarseVelocity[int3(b.x,  b.y,  b.z )].xyz;
    float3 c100 = CoarseVelocity[int3(hi.x, b.y,  b.z )].xyz;
    float3 c010 = CoarseVelocity[int3(b.x,  hi.y, b.z )].xyz;
    float3 c110 = CoarseVelocity[int3(hi.x, hi.y, b.z )].xyz;
    float3 c001 = CoarseVelocity[int3(b.x,  b.y,  hi.z)].xyz;
    float3 c101 = CoarseVelocity[int3(hi.x, b.y,  hi.z)].xyz;
    float3 c011 = CoarseVelocity[int3(b.x,  hi.y, hi.z)].xyz;
    float3 c111 = CoarseVelocity[int3(hi.x, hi.y, hi.z)].xyz;

    float3 x00 = lerp(c000, c100, f.x);
    float3 x10 = lerp(c010, c110, f.x);
    float3 x01 = lerp(c001, c101, f.x);
    float3 x11 = lerp(c011, c111, f.x);

    return lerp(lerp(x00, x10, f.y), lerp(x01, x11, f.y), f.z);
}

// -------------------------------------------------------------------
// Coarse burning-surface lookups.
//
// Coarse voxel c spans [c, c+1) in coarse units measured from the shared
// grid origin, and a fine position p (fine voxels) sits at p*FineOverCoarse
// in those units.
// -------------------------------------------------------------------

// 0..1 burning intensity of a coarse cell. Ramps in over the second half
// of the coarse ignition ramp, so voxels catching fire by spread fade
// their flame in rather than popping on.
float CoarseBurningAt(int3 c)
{
    if (any(c < 0) || any(c >= CoarseGridSize)) return 0.0;
    return saturate(CoarseBurning[c] * 2.0 - 1.0);
}

// How strongly a fine voxel sits on a burning surface, 0..1.
//
// Flame is emitted in a thin layer of air just outside the burning solid:
// full strength above burning top faces, half strength beside burning
// side faces, nothing under bottom faces. This is the fuel bed, taken
// directly from the shape of whatever is actually burning.
float BurningSurfaceWeight(float3 p)
{
    if (UseCoarseBurning < 0.5) return 0.0;

    float3 cp = p * FineOverCoarse;
    int3   c  = (int3)floor(cp);

    if (any(c < 0) || any(c >= CoarseGridSize)) return 0.0;

    // Inside a coarse solid (including runtime-spawned objects the fine
    // grid's obstacle bake never saw): not air, nothing to emit into.
    if (CoarseObstacle[c] > 0.5) return 0.0;

    float  cellFine = 1.0 / max(FineOverCoarse, 0.0001);   // fine voxels per coarse cell
    float3 local    = (cp - (float3)c) * cellFine;          // fine voxels from the cell's min corner
    float  depth    = max(SurfaceFlameDepth, 0.5);

    float w = 0.0;

    // Burning top face directly below.
    w = max(w, CoarseBurningAt(c + int3(0, -1, 0)) * saturate(1.0 - local.y / depth));

    // Burning side faces.
    const float side = 0.5;
    w = max(w, side * CoarseBurningAt(c + int3(-1, 0, 0)) * saturate(1.0 - local.x / depth));
    w = max(w, side * CoarseBurningAt(c + int3( 1, 0, 0)) * saturate(1.0 - (cellFine - local.x) / depth));
    w = max(w, side * CoarseBurningAt(c + int3( 0, 0,-1)) * saturate(1.0 - local.z / depth));
    w = max(w, side * CoarseBurningAt(c + int3( 0, 0, 1)) * saturate(1.0 - (cellFine - local.z) / depth));

    return w;
}

// Height of a fine position above the burning surface directly beneath
// it, in fine voxels. -1 if the first solid below is not burning, or if
// there is none within range. Gives burning surfaces the same plume frame
// (height above the bed) that emitters have.
float HeightAboveBurning(float3 p)
{
    if (UseCoarseBurning < 0.5) return -1.0;

    float3 cp = p * FineOverCoarse;
    int3   c  = (int3)floor(cp);

    if (any(c < 0) || any(c >= CoarseGridSize)) return -1.0;

    // 8 coarse cells: 1.6 m at 0.2 m cells -- covers the flame zone.
    for (int k = 0; k <= 8; k++)
    {
        int3 q = c - int3(0, k, 0);
        if (q.y < 0) break;

        if (CoarseObstacle[q] > 0.5)
        {
            if (CoarseBurning[q] > 0.5)
                return (cp.y - (float)(q.y + 1)) / max(FineOverCoarse, 0.0001);

            return -1.0;   // a solid that isn't burning: not over a fire
        }
    }

    return -1.0;
}

// -------------------------------------------------------------------
// Emitter geometry in PLUME coordinates.
//
// A fire is a fuel bed that a plume rises from. Everything that used to
// measure straight-line distance from the emitter centre -- emission,
// the persistent flame zone, the turbulence anchor -- treated the fire
// as a sphere, which is exactly why it started life as a ball. They now
// measure height above the bed and horizontal distance from the plume
// axis instead.
// -------------------------------------------------------------------
struct PlumeFrame
{
    float  h;       // voxels above the bed (negative below it)
    float2 radial;  // horizontal offset from the plume axis, voxels
    float  r;       // bed radius, voxels
};

bool NearestPlume(float3 p, out PlumeFrame f)
{
    f.h = 0.0;
    f.radial = float2(0.0, 0.0);
    f.r = 1.0;

    bool  found = false;
    float best  = 1e9;

    for (int i = 0; i < EmitterCount; i++)
    {
        EmitterData e = Emitters[i];
        float3 d = p - e.center;

        // Distance to the plume AXIS -- a vertical ray from the bed
        // upward -- so a point high in one plume isn't claimed by a
        // neighbouring bed that happens to be closer in a straight line.
        float dist = length(float3(d.x, min(d.y, 0.0), d.z)) - e.radius;

        if (dist < best)
        {
            best = dist;
            f.h = d.y;
            f.radial = d.xz;
            f.r = max(e.radius, 0.0001);
            found = true;
        }
    }

    // Burning surfaces. A surface has no single axis, so radial stays 0
    // and r is huge: entrainment and the off-bed dilution term switch off,
    // and only height above the surface matters. Used unless the point is
    // inside an emitter's own column.
    float hs = HeightAboveBurning(p);
    if (hs >= 0.0 && (!found || best > 0.0))
    {
        f.h = hs;
        f.radial = float2(0.0, 0.0);
        f.r = 1e4;
        found = true;
    }

    return found;
}

// Emission footprint of one bed: a thin lens, full radius horizontally
// and only FireBedThickness * radius tall. 1 at the centre, 0 at the rim.
float BedWeight(float3 p, EmitterData e)
{
    float  r     = max(e.radius, 0.0001);
    float3 d     = p - e.center;

    // At least ~1.5 voxels tall, so a small bed never falls between cells.
    float  halfH = max(r * FireBedThickness, 0.75);

    float  rh = length(d.xz);
    if (rh >= r || abs(d.y) >= halfH) return 0.0;

    float radial   = 1.0 - (rh * rh) / (r * r);  // broad and flat-topped
    float vertical = 1.0 - abs(d.y) / halfH;
    return radial * vertical;
}

// -------------------------------------------------------------------
// Mixture dilution, 0 at the fuel bed and 1 at the top of the persistent
// zone.
//
// A diffusion flame burns only while the local mixture sits between its
// flammability limits. Air entrained into the plume dilutes it, and that
// dilution grows with HEIGHT above the fuel -- and quickly once you move
// sideways off the bed. This decides where flame survives continuously.
// -------------------------------------------------------------------
float FlameDilution(float3 p)
{
    if (FlamePersistentRadius <= 0.0001) return 0.0;

    PlumeFrame f;
    if (!NearestPlume(p, f)) return 0.0;

    float above   = max(f.h, 0.0) / FlamePersistentRadius;
    float outside = max(length(f.radial) - f.r, 0.0) / max(f.r, 1.0);

    return saturate(above + outside);
}

// ~0 where density is locally uniform (the plume core, and empty air),
// ~1 at a density boundary. Multiplying the warp by this is what stops the
// interior from riding the noise as one rigid block.
float ShellMask(int3 c)
{
    if (SmokeShellSharpness <= 0.0001) return 1.0;   // mask off, warp everywhere

    float gx = ReadSmoke(c + int3(1, 0, 0)) - ReadSmoke(c - int3(1, 0, 0));
    float gy = ReadSmoke(c + int3(0, 1, 0)) - ReadSmoke(c - int3(0, 1, 0));
    float gz = ReadSmoke(c + int3(0, 0, 1)) - ReadSmoke(c - int3(0, 0, 1));

    return saturate(length(float3(gx, gy, gz)) * SmokeShellSharpness);
}

// Same mask, built from the FIRE field.
//
// The flame used to be masked by the SMOKE gradient. But smoke is
// deliberately suppressed wherever flame is bright (SootLuminousCutoff),
// so inside and around the flame the smoke gradient is ~0 and the flame
// received almost no turbulence at all -- it held whatever shape it was
// emitted in. Masking by its own edge is what lets tongues peel off.
float ShellMaskFire(int3 c)
{
    if (SmokeShellSharpness <= 0.0001) return 1.0;

    float gx = ReadFire(c + int3(1, 0, 0)) - ReadFire(c - int3(1, 0, 0));
    float gy = ReadFire(c + int3(0, 1, 0)) - ReadFire(c - int3(0, 1, 0));
    float gz = ReadFire(c + int3(0, 0, 1)) - ReadFire(c - int3(0, 0, 1));

    return saturate(length(float3(gx, gy, gz)) * SmokeShellSharpness);
}

// A real plume is near-laminar for the first couple of source diameters
// and only then breaks into turbulence. Ramping the warp in with HEIGHT
// above the bed anchors the base so the column can't sway at its own
// root. (This used to be a sphere around the emitter, which held the
// whole emitted ball perfectly still and smooth.)
float EmitterAnchor(float3 p)
{
    if (SmokeAnchorRadius <= 0.0001) return 1.0;

    PlumeFrame f;
    if (!NearestPlume(p, f)) return 1.0;

    // Off to the side of the bed counts as "away from the root" too.
    float side = max(length(f.radial) - f.r, 0.0);

    return saturate(max(f.h, side) / SmokeAnchorRadius);
}

// -------------------------------------------------------------------

[numthreads(8,8,8)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;
    SmokeOut[id] = 0.0;
}

// -------------------------------------------------------------------
// SMOKE PIPELINE

[numthreads(8,8,8)]
void Emit(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    float current = SmokeIn[id];

    if (IsSolid(int3(id)))
    {
        SmokeOut[id] = current;
        return;
    }

    float3 p = float3(id) + 0.5;

    float fireHere = FireIn[id];

    // How much this cell is inside the luminous reaction zone. Soot here
    // is incandescent rather than obscuring, so BOTH smoke sources below
    // are suppressed by it. Gating only the fire-to-smoke conversion was
    // not enough: the emitter injects smoke directly, and that path was
    // dumping opaque soot straight onto the flame every tick, burying it.
    float luminous = saturate(1.0 - fireHere * SootLuminousCutoff);

    // Direct smoke from every bed. Uses the same lens footprint as the
    // flame: with a flat flame bed, a spherical smoke emitter would leave
    // the upper half of the old ball unlit and show up as a dark ball
    // sitting on top of the fire.
    for (int i = 0; i < EmitterCount; i++)
    {
        EmitterData e = Emitters[i];
        float w = BedWeight(p, e);
        if (w <= 0.0) continue;

        current += e.emitRate * DeltaTime * w * luminous;
    }

    // Direct smoke from burning surfaces in the thermal sim.
    current += SurfaceSmokeRate * DeltaTime * BurningSurfaceWeight(p) * luminous;

    // -----------------------------------------------------------------
    // Soot production.
    //
    // Soot forms inside the flame, but while it is in the reaction zone it
    // is incandescent -- it IS the flame's light, not an obstruction. It
    // only reads as opaque smoke once it has left the luminous region and
    // cooled. Generating smoke in proportion to flame intensity therefore
    // puts maximum smoke density exactly where the flame is, and the flame
    // ends up permanently hidden behind its own soot.
    //
    // Weighting by (1 - flame) instead produces smoke where the flame is
    // FADING: the base of the fire stays clean and luminous and the plume
    // darkens above it, which is what a real fire looks like.
    // -----------------------------------------------------------------
    if (fireHere > 0.01)
    {
        current += fireHere * luminous * FireToSmokeRate * DeltaTime;
    }

    SmokeOut[id] = saturate(current);
}
// -------------------------------------------------------------------
// Displacement shared by Step and StepFire, in FINE VOXELS per tick.
//
// Solver velocity supplies the resolved flow; curl noise supplies the
// sub-grid eddies. The noise is masked to the density boundary and ramped
// in away from the source, because a plume is near-laminar for its first
// couple of source diameters and only then breaks up.
//
// fireShell selects which field's edge masks the turbulence: the flame's
// own edge for StepFire, the smoke's for Step.
// -------------------------------------------------------------------
float3 TransportOffset(int3 c, float3 pp, float noiseScale,
                       float noiseStrength, float noiseSpeed,
                       float selfHeat, bool fireShell)
{
    // --- resolved flow from the coarse Navier-Stokes solve, m/s ---
    float3 vel = SampleCoarseVelocity(pp) * VelocityInfluence;

    // --- sub-grid buoyant rise, m/s ---
    //
    // This grid stores no velocity, so the old "acceleration * DeltaTime"
    // added only ONE tick's worth of speed (~0.3 m/s at full heat) and
    // never built up. Until the coarse solver spun up -- the better part
    // of a second, starting from still air -- nothing was really lifting
    // the flame, and it sat where it was emitted: as a ball.
    //
    // Use the speed that acceleration would already have produced
    // instead. A hot parcel rising h metres under reduced gravity
    // g' = g (T/Tamb - 1) reaches w = sqrt(2 g' h). That growth holds
    // through the continuous flame and levels off above it (McCaffrey's
    // near-field plume zones), so h is capped at the persistent height.
    //
    // max() with the solver velocity rather than adding: once the coarse
    // plume is established it already contains this rise, and adding the
    // two would double-count it.
    if (SubGridBuoyancy > 0.0 && selfHeat > 0.0)
    {
        float ratio = lerp(1.0, FlameGasTempK / max(AmbientTempK, 1.0), selfHeat);
        float gRed  = 9.81 * max(ratio - 1.0, 0.0);              // m/s^2

        PlumeFrame f;
        bool inPlume = NearestPlume(pp, f);

        // Flame that is not over any known bed has already been carried
        // up and away from it, so it gets the full plume speed.
        float hMax = max(FlamePersistentRadius, 1.0);
        float hVox = inPlume ? clamp(f.h, 0.5, hMax) : hMax;

        float wBuoy = sqrt(2.0 * gRed * hVox * CellSizeMeters) * SubGridBuoyancy;

        vel.y = max(vel.y, wBuoy);

        // Entrainment. Ambient air is drawn in at roughly alpha * w,
        // which necks the flame toward its axis -- the taper that makes a
        // fire read as a flame rather than a column. Only meaningful for
        // emitters, which have an axis; surfaces leave radial at 0.
        float rLen = length(f.radial);
        if (inPlume && PlumeEntrainment > 0.0 && f.h > 0.0 && rLen > 0.001)
        {
            float2 inward = -f.radial / rLen;
            vel.xz += inward * PlumeEntrainment * wBuoy *
                      saturate(rLen / max(f.r, 1.0));
        }
    }

    // metres/second -> fine voxels this tick
    float3 offset = vel * DeltaTime / max(CellSizeMeters, 0.0001);

    // --- sub-grid turbulence, already in voxels ---
    float3 turb = (SmokeUseCurlNoise > 0.5)
        ? CurlNoise(pp, noiseScale, noiseSpeed)
        : NoiseVelocity(pp, noiseScale, noiseSpeed);

    // if/else rather than ?: -- HLSL may evaluate both sides of a ternary,
    // and there's no reason to pay for both gradients.
    float shell;
    if (fireShell) shell = ShellMaskFire(c);
    else           shell = ShellMask(c);

    turb *= noiseStrength * shell * EmitterAnchor(pp);

    offset += turb;

    // --- authored wind / vent attraction ---
    //
    // WindStrength is metres per second, and must be converted the same
    // way the solver velocity above is. It used to be added raw, i.e. as
    // voxels PER TICK: at strength 2 with a 0.15 cell on a 50Hz
    // FixedUpdate that was 15 m/s, which on its own exceeded
    // SmokeWarpClamp (1.2) and so clipped away the solver velocity,
    // buoyancy and turbulence entirely. Wind stopped being one term among
    // several and became the only one, which is why nothing else appeared
    // to affect plume height.
    offset += WindDirection * WindStrength * DeltaTime /
              max(CellSizeMeters, 0.0001);

    if (AttractorStrength > 0.0)
    {
        // Box attractor rather than a point.
        //
        // A point attractor pulls radially from every direction, so smoke
        // converges on one spot and reads as a plughole. A doorway or vent
        // is a REGION smoke passes through: outside it you are drawn to the
        // nearest face, inside it you keep travelling along the opening's
        // axis instead of collapsing to the middle.
        //
        // Standard signed-distance form for a box: offset by the half
        // extents, clamp the negatives away, and the length of what remains
        // is the distance to the surface -- exactly 0 anywhere inside.
        float3 d = pp - AttractorCenter;
        float3 q = abs(d) - AttractorHalfExtents;
        float3 outside = max(q, 0.0);
        float dist = length(outside);

        float pull = saturate(1.0 - dist / max(AttractorRadius, 0.0001));

        float3 dir;
        if (dist > 0.001)
        {
            // Toward the nearest point on the box. Only the axes actually
            // outside contribute, so flow arrives roughly perpendicular to
            // the nearest face rather than aiming at the centre -- which is
            // what makes it read as a draught instead of a vacuum.
            dir = -normalize(outside * sign(d));
        }
        else
        {
            // Inside the opening: carry on through it. Without this the
            // smoke reaches the box and stalls, which looks worse than the
            // point attractor did.
            dir = AttractorFlowDir;
        }

        // Same m/s -> voxels-per-tick conversion as the wind above.
        offset += dir * pull * AttractorStrength *
                  DeltaTime / max(CellSizeMeters, 0.0001);
    }

    return clamp(offset, -SmokeWarpClamp, SmokeWarpClamp);
}

[numthreads(8,8,8)]
void Step(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    int3 c = int3(id);
    if (IsSolid(c))
    {
        SmokeOut[id] = 0.0;
        return;
    }

    float3 pc = float3(id);        // cell centre in sampling space
    float3 pp = pc + 0.5;          // voxel space; matches emitter coords

    float3 offset = TransportOffset(c, pp, SmokeNoiseScale,
                                    SmokeNoiseStrength, SmokeNoiseSpeed,
                                    0.0, false);

    // -----------------------------------------------------------------
    // MacCormack advection.
    //
    // Plain semi-Lagrangian takes one trilinear sample, and trilinear is
    // an 8-cell average -- i.e. a blur kernel applied 50 times a second.
    // That is what turns sharp plume structure into a soft blob.
    //
    // MacCormack traces back, traces the result forward again, and
    // corrects by half the round-trip error. The limiter afterwards is
    // not optional: the correction is unstable without it.
    // -----------------------------------------------------------------
    float3 back = pc - offset;

    float phiHat  = SampleSmoke(back);            // standard SL result
    float phiBack = SampleSmoke(back + offset);   // trace it forward again

    float here = phiHat + 0.5 * (SmokeIn[id] - phiBack);

    float lo, hi;
    SampleBoundsSmoke(back, lo, hi);
    here = clamp(here, lo, hi);

    // -----------------------------------------------------------------
    // Physical diffusion only. Rise, settling and ceiling rollover are
    // NOT written by hand any more -- they emerge from the solver's
    // buoyancy term and from pressure projection redirecting the flow
    // sideways when it hits a ceiling, which is the correct mechanism.
    // -----------------------------------------------------------------
    float result = here;

    if (SmokeDiffusion > 0.0)
    {
        float xp = SampleSmokeWall(back + float3( 1, 0, 0), here);
        float xn = SampleSmokeWall(back + float3(-1, 0, 0), here);
        float yp = SampleSmokeWall(back + float3( 0, 1, 0), here);
        float yn = SampleSmokeWall(back + float3( 0,-1, 0), here);
        float zp = SampleSmokeWall(back + float3( 0, 0, 1), here);
        float zn = SampleSmokeWall(back + float3( 0, 0,-1), here);

        float laplacian = (xp + xn + yp + yn + zp + zn) - 6.0 * here;

        result += laplacian * SmokeDiffusion * DeltaTime;
    }

    result *= (1.0 - DecayRate * DeltaTime);

    SmokeOut[id] = saturate(max(result, 0.0));
}

// -------------------------------------------------------------------
// FIRE PIPELINE

[numthreads(8,8,8)]
void EmitFire(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    float current = FireIn[id];

    if (IsSolid(int3(id)))
    {
        FireOut[id] = current;
        return;
    }

    float3 p = float3(id) + 0.5;

    // Contributions from every bed -- taking the MAX rather than sum so
    // overlapping fires don't create abnormally bright cores. Per-emitter
    // phase offset makes multiple fires flicker independently.
    for (int i = 0; i < EmitterCount; i++)
    {
        EmitterData e = Emitters[i];

        float w = BedWeight(p, e);
        if (w <= 0.0) continue;

        float phase = float(i) * 1.7;

        // -------------------------------------------------------------
        // Hot spots.
        //
        // A real fuel bed doesn't burn uniformly: it has several hotter
        // patches, and each one feeds its own flame tongue. A uniform disc
        // rises as one slab; breaking it into patches gives the flow
        // separate columns to work with from the very first tick, so the
        // fire already has tongues before any turbulence has developed.
        // Patches come and go over time rather than sliding sideways.
        // -------------------------------------------------------------
        float3 d = p - e.center;
        float spots = ValueNoise(float3(d.x * FireBedNoiseScale,
                                        d.z * FireBedNoiseScale,
                                        Time_ * FireBedNoiseSpeed + phase * 10.0));
        float tongue = smoothstep(0.35, 0.75, spots);
        w *= lerp(1.0, tongue, FireBedBreakup);

        float flickerA = sin(Time_ * 12.0 + Hash3(p) * 6.28 + phase) * 0.5 + 0.5;
        float flickerB = sin(Time_ * 7.3  + Hash3(p + 100) * 6.28 + phase) * 0.5 + 0.5;
        float flicker = 0.6 + 0.4 * flickerA * flickerB;

        current = max(current, w * flicker * e.fireRate);
    }

    // Burning surfaces from the thermal sim, with the same hot-spot
    // breakup and flicker as an emitter bed. Noise is in world xz so
    // neighbouring surfaces share one continuous pattern of tongues.
    float surf = BurningSurfaceWeight(p);
    if (surf > 0.0)
    {
        float spots = ValueNoise(float3(p.x * FireBedNoiseScale,
                                        p.z * FireBedNoiseScale,
                                        Time_ * FireBedNoiseSpeed));
        float tongue = smoothstep(0.35, 0.75, spots);
        surf *= lerp(1.0, tongue, FireBedBreakup);

        float flickerA = sin(Time_ * 12.0 + Hash3(p) * 6.28) * 0.5 + 0.5;
        float flickerB = sin(Time_ * 7.3  + Hash3(p + 100) * 6.28) * 0.5 + 0.5;
        float flicker = 0.6 + 0.4 * flickerA * flickerB;

        current = max(current, surf * flicker * SurfaceFireRate);
    }

    FireOut[id] = saturate(current);
}
[numthreads(8,8,8)]
void StepFire(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    int3 c = int3(id);
    if (IsSolid(c))
    {
        FireOut[id] = 0.0;
        return;
    }

    float3 pc = float3(id);
    float3 pp = pc + 0.5;

    float selfHeat = FireIn[id];

    // Fire uses its own noise band but the SAME solver velocity, which is
    // what keeps flame and smoke moving as one plume instead of two.
    float3 offset = TransportOffset(c, pp, FireNoiseScale,
                                    FireNoiseStrength, FireNoiseSpeed,
                                    selfHeat, true);

    // MacCormack, same reasoning as Step. Sharpness matters more here
    // than anywhere else -- a diffused flame is exactly what "too fluid"
    // looks like.
    float3 back = pc - offset;

    float phiHat  = SampleFire(back);
    float phiBack = SampleFire(back + offset);

    float here = phiHat + 0.5 * (selfHeat - phiBack);

    float lo, hi;
    SampleBoundsFire(back, lo, hi);
    here = clamp(here, lo, hi);

    // Flame lifetime. A diffusion flame is not transported indefinitely --
    // it exists only while fuel and oxidiser are still mixing, so it burns
    // out over a fixed timescale rather than being advected forever.
    float result = here * (1.0 - FireDecayRate * DeltaTime);

    // -----------------------------------------------------------------
    // Intermittency.
    //
    // A real flame is continuously luminous only in the persistent zone
    // near the fuel bed. Higher up, entrained air pushes the mixture below
    // its lower flammability limit MOST of the time, so flame appears only
    // in bursts -- fuel-rich pockets carried up by shed vortices, burning
    // out in mid-air. At the tip, flame is lit under ~5% of the time.
    //
    // Extinction is modulated by noise rather than applied smoothly, which
    // is what makes pockets detach instead of the column simply fading. A
    // uniform fade produces a gas burner; this produces a wood fire.
    // -----------------------------------------------------------------
    if (FlameIntermittency > 0.0)
    {
        float dilution = FlameDilution(pp);

        float pocket = FBM(pp * FireNoiseScale * 2.0 +
                           float3(0.0, -Time_ * 3.0, 0.0));

        float extinction = saturate(dilution * (0.35 + pocket * 1.3));

        result *= saturate(1.0 - FlameIntermittency * extinction * DeltaTime);
    }

    // Trim the faint tail so flame tips stay defined instead of fading
    // into a haze.
    result = max(0.0, result - FireCutoff * DeltaTime);

    FireOut[id] = saturate(result);
}

// -------------------------------------------------------------------
// Reaction-sheet emission.
//
// A real diffusion flame is luminous only in a thin layer where fuel and
// oxidiser meet at stoichiometric ratio -- that is why fire looks like
// overlapping tongues rather than a solid glowing mass. The simulated
// fire field is a filled volume, so weighting emission by the magnitude
// of its gradient recovers the sheet structure.
//
// This writes a SEPARATE texture: the simulation keeps working on the
// physical field, and only the rendered field is sheet-weighted.
// -------------------------------------------------------------------
[numthreads(8,8,8)]
void FireEmission(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    int3 c = int3(id);
    if (IsSolid(c))
    {
        FireEmissionOut[id] = 0.0;
        return;
    }

    float flame = FireIn[id];

    float3 gradF = float3(
        ReadFire(c + int3(1, 0, 0)) - ReadFire(c - int3(1, 0, 0)),
        ReadFire(c + int3(0, 1, 0)) - ReadFire(c - int3(0, 1, 0)),
        ReadFire(c + int3(0, 0, 1)) - ReadFire(c - int3(0, 0, 1))) * 0.5;

    float sheet = saturate(length(gradF) * ReactionSheetScale);

    FireEmissionOut[id] = saturate(flame * lerp(1.0, sheet, ReactionSheetWeight));
}

// AsyncGPUReadback.Request on a Tex3D returns only z=0 on many backends.
// To read a full volume reliably, copy it to a linear StructuredBuffer
// first (buffers don't have this limitation), then read the buffer.
Texture3D<float>          CopySource;
RWStructuredBuffer<float> CopyDest;
int3                      CopyDims;

[numthreads(8,8,4)]
void CopyVolumeToBuffer(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)CopyDims.x || id.y >= (uint)CopyDims.y || id.z >= (uint)CopyDims.z)
        return;

    int index = id.x + CopyDims.x * (id.y + CopyDims.y * id.z);
    CopyDest[index] = CopySource[id];
}
