#pragma kernel Emit
#pragma kernel Step
#pragma kernel EmitFire
#pragma kernel StepFire
#pragma kernel Clear

// --- Smoke field ---
Texture3D<float>    SmokeIn;
RWTexture3D<float>  SmokeOut;

// --- Fire field ---
Texture3D<float>    FireIn;
RWTexture3D<float>  FireOut;

// Solid geometry.
Texture3D<float>    Obstacle;

int3   GridSize;
float  DeltaTime;
float  Time_;

// Per-emitter data uploaded as a StructuredBuffer -- supports any number
// of active fire sources sharing the same sim grid.
struct EmitterData
{
    float3 center;      // voxel space
    float  radius;      // voxel space
    float  emitRate;    // smoke density added per second at center
    float  fireRate;    // fire density set per tick (max'd, not added)
};

StructuredBuffer<EmitterData> Emitters;
int EmitterCount;

// Smoke physics.
float  RiseSpeed;
float  SettleSpeed;
float  CeilingSpread;
float  DecayRate;

// Fire physics.
float  FireRiseSpeed;
float  FireDecayRate;
float  FireToSmokeRate;
float  FireCeilingSpread;

// Noise turbulence.
float FireNoiseScale;
float FireNoiseStrength;
float FireNoiseSpeed;
float SmokeNoiseScale;
float SmokeNoiseStrength;
float SmokeNoiseSpeed;

// -------------------------------------------------------------------

bool InBounds(int3 p)
{
    return all(p >= int3(0,0,0)) && all(p < GridSize);
}

bool IsSolid(int3 p)
{
    if (!InBounds(p)) return true;
    return Obstacle[p] > 0.5;
}

float ReadSmoke(int3 p)
{
    if (!InBounds(p) || IsSolid(p)) return 0.0;
    return SmokeIn[p];
}

float ReadFire(int3 p)
{
    if (!InBounds(p) || IsSolid(p)) return 0.0;
    return FireIn[p];
}

float Hash3(float3 p)
{
    return frac(sin(dot(p, float3(12.9898, 78.233, 37.719))) * 43758.5453);
}

// Value noise + fractal Brownian motion.
float ValueNoise(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);

    float n000 = Hash3(i + float3(0, 0, 0));
    float n100 = Hash3(i + float3(1, 0, 0));
    float n010 = Hash3(i + float3(0, 1, 0));
    float n110 = Hash3(i + float3(1, 1, 0));
    float n001 = Hash3(i + float3(0, 0, 1));
    float n101 = Hash3(i + float3(1, 0, 1));
    float n011 = Hash3(i + float3(0, 1, 1));
    float n111 = Hash3(i + float3(1, 1, 1));

    float x00 = lerp(n000, n100, f.x);
    float x10 = lerp(n010, n110, f.x);
    float x01 = lerp(n001, n101, f.x);
    float x11 = lerp(n011, n111, f.x);
    float y0  = lerp(x00, x10, f.y);
    float y1  = lerp(x01, x11, f.y);
    return lerp(y0, y1, f.z);
}

float FBM(float3 p)
{
    float total = 0.0;
    float amp = 0.5;
    float freq = 1.0;
    for (int i = 0; i < 3; i++)
    {
        total += ValueNoise(p * freq) * amp;
        freq *= 2.1;
        amp  *= 0.5;
    }
    return total;
}

// Noise-based velocity offset. Biased upward and vertically stretched so
// eddies look like rising flame streaks rather than round spinning blobs.
float3 NoiseVelocity(float3 p, float scale, float speed)
{
    float3 stretchedP = float3(p.x, p.y * 0.4, p.z);

    float3 q = stretchedP * scale + float3(Time_ * speed *  0.3,
                                            Time_ * speed * -2.0,
                                            Time_ * speed *  0.3);

    float ax = FBM(q + float3(  0.0,   0.0,   0.0)) - FBM(q + float3( 47.3,  91.7,  13.1));
    float ay = FBM(q + float3(101.9,  17.3,  61.5)) - FBM(q + float3(-33.7,  55.9, -22.1));
    float az = FBM(q + float3( 71.1,  29.4, 143.2)) - FBM(q + float3( 12.5, -87.3,  99.4));

    return float3(ax, ay, az) * 2.0;
}

// -------------------------------------------------------------------

[numthreads(8,8,8)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;
    SmokeOut[id] = 0.0;
}

// -------------------------------------------------------------------
// SMOKE PIPELINE

[numthreads(8,8,8)]
void Emit(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    float current = SmokeIn[id];

    if (IsSolid(int3(id)))
    {
        SmokeOut[id] = current;
        return;
    }

    float3 p = float3(id) + 0.5;

    // Contributions from every active emitter. Squared-distance early-out
    // skips the sqrt when clearly outside the ball -- cheap perf win when
    // you have many emitters and most voxels are far from all of them.
    for (int i = 0; i < EmitterCount; i++)
    {
        EmitterData e = Emitters[i];
        float3 diff = p - e.center;
        float distSq = dot(diff, diff);
        float rSq = e.radius * e.radius;
        if (distSq >= rSq) continue;

        float d = sqrt(distSq);
        float w = 1.0 - d / max(e.radius, 0.0001);
        current += e.emitRate * DeltaTime * w;
    }

    // Burning voxels also produce smoke, regardless of source.
    float fireHere = FireIn[id];
    if (fireHere > 0.01)
    {
        current += fireHere * FireToSmokeRate * DeltaTime;
    }

    SmokeOut[id] = saturate(current);
}

[numthreads(8,8,8)]
void Step(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    if (IsSolid(int3(id)))
    {
        SmokeOut[id] = 0.0;
        return;
    }

    int3 c = int3(id);

    // Sample noise for this voxel's turbulence direction.
    float3 pp = float3(id) + 0.5;
    float3 noise = NoiseVelocity(pp, SmokeNoiseScale, SmokeNoiseSpeed);

    // Shell warp: read `here` from a noise-displaced position so smoke's
    // outline wobbles, matching Kelvin-Helmholtz billowing behaviour.
    float offX = clamp(noise.x * SmokeNoiseStrength, -2.0, 2.0);
    float offY = clamp(noise.y * SmokeNoiseStrength * 0.5, -1.0, 1.0);
    float offZ = clamp(noise.z * SmokeNoiseStrength, -2.0, 2.0);

    int3 herePos = c + int3((int)round(offX), (int)round(offY), (int)round(offZ));
    float here = ReadSmoke(herePos);

    // Rise sample: pull from below with lighter noise offset, blended with
    // straight-below so we always have some vertical component regardless
    // of what the noise says this frame.
    int3 belowPos = c + int3((int)round(offX * 0.7), -1, (int)round(offZ * 0.7));
    float noiseBelow = ReadSmoke(belowPos);
    float straightBelow = ReadSmoke(c + int3(0, -1, 0));
    float below = noiseBelow * 0.5 + straightBelow * 0.5;

    float above = ReadSmoke(c + int3(0, 1, 0));

    bool ceilingAbove = IsSolid(c + int3(0,  1, 0));
    bool floorBelow   = IsSolid(c + int3(0, -1, 0));

    float riseIn  = below * RiseSpeed * DeltaTime;
    float riseOut = ceilingAbove ? 0.0 : here * RiseSpeed * DeltaTime;

    // Settle only where we're NOT in an active rising column, so the plume
    // rises cleanly while outer edges of the ceiling layer drift down.
    bool activeRisingColumn = (below > here * 0.5);
    float settleIn = 0.0;
    float settleOut = 0.0;
    if (!activeRisingColumn)
    {
        settleIn  = above * SettleSpeed * DeltaTime;
        settleOut = floorBelow ? 0.0 : here * SettleSpeed * DeltaTime;
    }

    // Horizontal ceiling spread: applies to the row under a ceiling AND
    // rows below with smoke above -- lets the layer thicken downward.
    float horizontal = 0.0;
    bool inLayer = ceilingAbove || (above > 0.1);
    if (inLayer)
    {
        int3 xpP = c + int3( 1, 0, 0);
        int3 xnP = c + int3(-1, 0, 0);
        int3 zpP = c + int3( 0, 0, 1);
        int3 znP = c + int3( 0, 0,-1);

        float xp = IsSolid(xpP) ? here : SmokeIn[xpP];
        float xn = IsSolid(xnP) ? here : SmokeIn[xnP];
        float zp = IsSolid(zpP) ? here : SmokeIn[zpP];
        float zn = IsSolid(znP) ? here : SmokeIn[znP];

        float laplacian = (xp + xn + zp + zn) - 4.0 * here;
        horizontal = laplacian * CeilingSpread * DeltaTime;
    }

    float result = here
                 + riseIn - riseOut
                 + settleIn - settleOut
                 + horizontal;

    result *= (1.0 - DecayRate * DeltaTime);
    SmokeOut[id] = saturate(max(result, 0.0));
}

// -------------------------------------------------------------------
// FIRE PIPELINE

[numthreads(8,8,8)]
void EmitFire(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    float current = FireIn[id];

    if (IsSolid(int3(id)))
    {
        FireOut[id] = current;
        return;
    }

    float3 p = float3(id) + 0.5;

    // Contributions from every emitter -- taking the MAX rather than sum
    // so overlapping fires don't create abnormally bright cores. Per-emitter
    // phase offset makes multiple fires flicker independently.
    for (int i = 0; i < EmitterCount; i++)
    {
        EmitterData e = Emitters[i];
        float3 diff = p - e.center;
        float distSq = dot(diff, diff);
        float rSq = e.radius * e.radius;
        if (distSq >= rSq) continue;

        float d = sqrt(distSq);
        float w = 1.0 - d / max(e.radius, 0.0001);

        float phase = float(i) * 1.7;
        float flickerA = sin(Time_ * 12.0 + Hash3(p) * 6.28 + phase) * 0.5 + 0.5;
        float flickerB = sin(Time_ * 7.3  + Hash3(p + 100) * 6.28 + phase) * 0.5 + 0.5;
        float flicker = 0.6 + 0.4 * flickerA * flickerB;

        current = max(current, w * flicker * e.fireRate);
    }

    FireOut[id] = saturate(current);
}

[numthreads(8,8,8)]
void StepFire(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)GridSize)) return;

    if (IsSolid(int3(id)))
    {
        FireOut[id] = 0.0;
        return;
    }

    int3 c = int3(id);

    float3 p = float3(id) + 0.5;
    float3 noise = NoiseVelocity(p, FireNoiseScale, FireNoiseSpeed);

    // Shell warp for fire outline wobble.
    float offX = clamp(noise.x * FireNoiseStrength, -2.0, 2.0);
    float offY = clamp(noise.y * FireNoiseStrength * 0.5, -1.0, 1.0);
    float offZ = clamp(noise.z * FireNoiseStrength, -2.0, 2.0);

    int3 herePos = c + int3((int)round(offX), (int)round(offY), (int)round(offZ));
    float here = ReadFire(herePos);

    int3 belowPos = c + int3((int)round(offX * 0.7), -1, (int)round(offZ * 0.7));
    float noiseBelow = ReadFire(belowPos);
    float straightBelow = ReadFire(c + int3(0, -1, 0));
    float below = noiseBelow * 0.6 + straightBelow * 0.4;

    bool ceilingAbove = IsSolid(c + int3(0, 1, 0));

    float riseIn  = below * FireRiseSpeed * DeltaTime;
    float riseOut = ceilingAbove ? 0.0 : here * FireRiseSpeed * DeltaTime;

    // Ceiling rollover.
    float horizontal = 0.0;
    if (ceilingAbove)
    {
        int3 xpP = c + int3( 1, 0, 0);
        int3 xnP = c + int3(-1, 0, 0);
        int3 zpP = c + int3( 0, 0, 1);
        int3 znP = c + int3( 0, 0,-1);

        float xp = IsSolid(xpP) ? here : FireIn[xpP];
        float xn = IsSolid(xnP) ? here : FireIn[xnP];
        float zp = IsSolid(zpP) ? here : FireIn[zpP];
        float zn = IsSolid(znP) ? here : FireIn[znP];

        float laplacian = (xp + xn + zp + zn) - 4.0 * here;
        horizontal = laplacian * FireCeilingSpread * DeltaTime;
    }

    float result = here + riseIn - riseOut + horizontal;

    result *= (1.0 - FireDecayRate * DeltaTime);

    FireOut[id] = saturate(max(result, 0.0));
}